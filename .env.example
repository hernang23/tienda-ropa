# ============================================================
# tienda-ropa - Variables de entorno de ejemplo
# Copie este archivo como .env y ajuste los valores.
# NUNCA versione el archivo .env real con secretos.
# ============================================================

# ---- PostgreSQL (usado por docker-compose y el backend) ----
DB_NAME=tienda_ropa
DB_USER=tienda
# Contraseña ilustrativa. Genere una propia: openssl rand -base64 24
DB_PASSWORD=cambie-esta-password
# Puerto expuesto en el host para acceder a la base desde fuera de Docker
DB_PORT_HOST=5432

# ---- Backend Spring Boot ----
SERVER_PORT=8080
# En docker-compose el backend se conecta al servicio "db"
DB_HOST=db
DB_PORT=5432

# ---- JWT ----
# Secreto HS256 de minimo 256 bits, codificado en Base64.
# Genere uno nuevo SIEMPRE para produccion:
#   openssl rand -base64 48
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1zZWNyZXRvLWNoYW5nZWItZW4tcHJvZHVjY2lvbi0yNTYtYml0cw==
# Expiracion del access token en minutos (defecto: 480 = 8 horas)
JWT_EXPIRACION_MINUTOS=480

# ---- CORS ----
# Origenes permitidos separados por coma. En Docker el frontend se sirve en http://localhost:3000
CORS_ORIGINES=http://localhost:5173,http://localhost:3000

# ---- Frontend ----
# URL base de la API que usa el navegador.
# Con docker-compose: /api (el nginx del frontend hace proxy al backend).
# En desarrollo local con Vite: puede dejarlo vacio y usar el proxy de vite.config.ts
VITE_API_URL=/api
# Proxy de desarrollo de Vite hacia el backend local
VITE_PROXY_TARGET=http://localhost:8080

# ---- Inicializacion segura del administrador ----
# El usuario admin se crea via migracion Flyway con credenciales de DESARROLLO.
# Para produccion, cambie la contraseña inmediatamente tras el primer inicio
# (modulo Configuracion > Perfil > Cambiar contrasena) o reemplace el hash
# de la migracion V2__datos_semilla.sql antes de la primera ejecucion.
# Ver README.md -> "Inicializacion del administrador".
